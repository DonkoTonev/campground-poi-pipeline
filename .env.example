# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://poi:poi@localhost:5433/poi
ELASTICSEARCH_URL=http://localhost:9200
REGION=sierra

# Public contact URL placed in the crawler/API User-Agent (required for outbound requests).
CONTACT_URL=

# LLM extraction (default provider: Haiku, escalating to Sonnet).
ANTHROPIC_API_KEY=
# Optional alternative provider (`poi extract --provider gemini`).
GEMINI_API_KEY=
RIDB_API_KEY=
NPS_API_KEY=

RAW_STORE=local
# RAW_STORE_S3_BUCKET=

LOG_LEVEL=INFO
LOG_JSON=false
# POI_LIVE_TESTS=1   # opt in to tests that hit real external APIs
